# Frontend environment. Copy to .env.local for local development, and set the
# same variable in the Vercel project settings for deploys.

# Base URL of the FastAPI backend. No trailing slash — lib/api.ts concatenates
# paths that already start with "/", so a trailing slash produces
# "//api/game/range" and a 404.
#
# NEXT_PUBLIC_* is inlined at BUILD time, not read at runtime: a Vercel build
# without this bakes in the localhost fallback and ships a dead site, and
# changing it later needs a redeploy rather than a restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
