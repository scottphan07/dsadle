# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the examples are documentation and must ship. `.env*` matches at any
# depth, so without these the example files are silently skipped by `git add`.
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python backend
#
# These rules used to live in backend/.gitignore, which venv had auto-written as
# a blanket `*` — that ignored every file under backend/, so any NEW file there
# was silently skipped by `git add`. Keeping them here instead means a future
# `python -m venv .venv` can't clobber them (it writes a self-contained
# .venv/.gitignore).
backend/.venv/
# the db itself, plus .db.bak and any -wal / -shm sidecars
backend/dsadle.db*
backend/__pycache__/
backend/**/__pycache__/
# A venv was also created directly into backend/ itself; its bin/python is an
# absolute symlink into /Library/Frameworks, so it is host-specific junk.
backend/bin/
backend/include/
backend/lib/
backend/lib64
backend/share/
backend/pyvenv.cfg

# local-only notes (kept on disk, deliberately not pushed)
ARCHITECTURE.md
