# Backend environment variables. Copy the ones you need into your host's
# dashboard (Render/Railway/Fly/etc). Nothing here is auto-loaded: the app reads
# os.environ directly and has no python-dotenv dependency, deliberately — a
# zero-config local run should keep working.

# "development" (default) or anything else for production.
# Outside development the app REFUSES TO START without a real API_KEY, rather
# than silently accepting the published default.
APP_ENV=development

# Guards the /api/questions admin endpoints, which return name + description —
# i.e. every answer. Generate one with:  openssl rand -hex 32
# Optional in development (falls back to "dev-key"); mandatory otherwise, and
# the literal "dev-key" is rejected in production because it is printed in the
# README.
API_KEY=

# Comma-separated browser origins allowed to call the API. No trailing slashes.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 when unset.
CORS_ORIGINS=https://your-app.vercel.app

# Optional. For hosts that mint a URL per deploy, e.g. Vercel preview builds:
#   CORS_ORIGIN_REGEX=https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# Where the SQLite file lives. Point this at a mounted volume in production —
# the default sits inside the app directory and is wiped on every redeploy.
#   DSADLE_DB_PATH=/var/data/dsadle.db
DSADLE_DB_PATH=

# Overrides DSADLE_DB_PATH entirely. The escape hatch to Postgres later without
# a code change (add a driver to requirements.txt):
#   DATABASE_URL=postgresql+psycopg://user:pass@host/dbname
DATABASE_URL=

# PORT is supplied by the host; bind it explicitly in the start command:
#   python seed.py --replace && uvicorn main:app --host 0.0.0.0 --port $PORT
